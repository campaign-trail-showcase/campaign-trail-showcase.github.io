title.textContent = "Settings";

const grid = document.createElement("div");
grid.className = "heir-settings-grid";

const state = {controls:{}};

[
["Difficulty","difficulty"],
["Slide 3","slide"]
].forEach(([label,key]) => {
const row = createCarouselRow(label,key,state);
grid.append(row.label,row.carousel);
});

const footer = document.createElement("div");
footer.className = "heir-settings-footer";

