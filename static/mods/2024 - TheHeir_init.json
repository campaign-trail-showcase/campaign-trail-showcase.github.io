JSON.parse(localStorage.getItem(STORAGE_KEY) || "null") || {}
);
} catch {
return sanitizeSettings(DEFAULT_SETTINGS);
}
}

function saveSettings(settings) {
try {
localStorage.setItem(STORAGE_KEY,JSON.stringify(settings));
