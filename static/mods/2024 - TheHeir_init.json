document.head.appendChild(style);

function controlText(control) {
return String(
control?.value ||
control?.textContent ||
""
)
.replace(/\s+/g," ")
.trim()
.toLowerCase();
}

function findNavigationButton(gameWindow,type) {
const controls = [
...gameWindow.querySelectorAll(
'button,input[type="button"],input[type="submit"]'
)
].filter(control => !control.closest("#heir-settings-screen"));

const expressions = type === "back"
? [/^back$/,/^volver$/,/^atrás$/,/^atras$/]
: [/^continue$/,/^continuar$/,/^siguiente$/];

return controls.find(control =>
expressions.some(regex => regex.test(controlText(control)))
) || null;
}

function setDefaultGameType(select) {
if (!select) return;

const options = [...select.options];

const option = options.find(item => {
const text = item.textContent.trim().toLowerCase();
return (
text.includes("default") ||
text.includes("winner-take-all")
);
}) || options[0];

if (option) {
select.value = option.value;
option.selected = true;
}
}

function setNativeDifficulty(select,nativeName,emitChange = false) {
if (!select) return false;

const wanted = nativeName.trim().toLowerCase();

const option = [...select.options].find(item =>
item.textContent.trim().toLowerCase() === wanted
);

if (!option) {
console.warn(
`The Heir: no existe la dificultad nativa “${nativeName}”.`
);
return false;
}

select.value = option.value;
option.selected = true;

if (emitChange) {
select.dispatchEvent(new Event("input",{bubbles:true}));
select.dispatchEvent(new Event("change",{bubbles:true}));
}

return true;
}

function createArrow(direction,label,action) {
const button = document.createElement("button");

button.type = "button";
button.className =
`heir-settings-arrow heir-settings-arrow-${direction}`;
button.setAttribute("aria-label",label);
button.addEventListener("click",action);

return button;
}

function createCarouselRow(labelText,key,state) {
    const label = document.createElement("div");
    label.className = "heir-settings-label";

    const labelValue = document.createElement("span");
    labelValue.textContent = labelText;
    label.appendChild(labelValue);

    const carousel = document.createElement("div");
    carousel.className = "heir-settings-carousel";
    carousel.dataset.setting = key;

    // Continúa aquí el resto de tu función...

const value = document.createElement("div");
value.className = "heir-settings-value";
value.setAttribute("aria-live","polite");

const left = createArrow(
"left",
`Previous ${labelText}`,
() => moveCarousel(key,-1,state)
);

const right = createArrow(
"right",
`Next ${labelText}`,
() => moveCarousel(key,1,state)
);

carousel.append(left,value,right);
state.controls[key] = {value,left,right};

return {label,carousel};
}

function carouselItems(key) {
    return key === "difficulty" ? getAvailableDifficulties() : getAvailableSlideOptions();
}

function selectedIndex(key, items) {
    return key === "difficulty"
        ? items.findIndex(item => item.nativeName === draftSettings.difficulty)
        : items.findIndex(item => item.value === draftSettings.slide);
}

function renderCarousel(key, state) {
    const control = state.controls[key];
    const items = carouselItems(key);
    const index = Math.max(0, selectedIndex(key, items));
    const item = items[index];
    if (!item) return;

    const isDifficulty = key === "difficulty";
    if (isDifficulty) {
        draftSettings.difficulty = item.nativeName;
        control.value.dataset.difficulty = item.nativeName;
        control.value.innerHTML = item.html;
    } else {
        control.value.textContent = item.label;
    }

    control.left.disabled = items.length < 2 || (isDifficulty && index === 0);
    control.right.disabled = items.length < 2 || (isDifficulty && index === items.length - 1);
}

function renderAll(state) {
    renderCarousel("difficulty", state);
    renderCarousel("slide", state);
}

function moveCarousel(key, direction, state) {
    const items = carouselItems(key);
    if (!items.length) return;

    const index = Math.max(0, selectedIndex(key, items));
    if (key === "difficulty") {
        const next = Math.max(0, Math.min(items.length - 1, index + direction));
        draftSettings.difficulty = items[next].nativeName;
    } else {
        const next = (index + direction + items.length) % items.length;
        draftSettings.slide = items[next].value;
    }

    renderCarousel(key, state);
}

function commitSettings(nativeDifficulty,nativeGameType) {
draftSettings = sanitizeSettings(draftSettings);

setDefaultGameType(nativeGameType);

setNativeDifficulty(
nativeDifficulty,
draftSettings.difficulty,
true
);

saveSettings(draftSettings);
applyRuntimeSettings(draftSettings);
}

function resetSettings(nativeDifficulty,nativeGameType,state) {
draftSettings = sanitizeSettings(DEFAULT_SETTINGS);

setDefaultGameType(nativeGameType);

setNativeDifficulty(
nativeDifficulty,
draftSettings.difficulty,
true
);

saveSettings(draftSettings);
applyRuntimeSettings(draftSettings);
renderAll(state);
}

function installSettingsScreen() {
const gameWindow = document.querySelector("#game_window");
const nativeDifficulty =
document.querySelector("#difficulty_level_id");
const nativeGameType =
document.querySelector("#game_type_id");
const existing =
document.querySelector("#heir-settings-screen");

if (!gameWindow || !nativeDifficulty || !nativeGameType) {
existing?.remove();
gameWindow?.classList.remove("heir-settings-host");
return;
}

if (existing) return;

const nativeBack = findNavigationButton(gameWindow,"back");
const nativeContinue = findNavigationButton(gameWindow,"continue");

if (!nativeBack || !nativeContinue) return;

activeSettings = sanitizeSettings(activeSettings);
draftSettings = {...activeSettings};

setDefaultGameType(nativeGameType);

setNativeDifficulty(
nativeDifficulty,
draftSettings.difficulty,
false
);

const screen = document.createElement("section");
