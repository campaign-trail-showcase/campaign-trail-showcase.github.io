}

function sanitizeSettings(raw = {}) {
const difficulties = getAvailableDifficulties();
const difficultyNames = difficulties.map(x => x.nativeName);

return {
difficulty: difficultyNames.includes(raw.difficulty)
  ? raw.difficulty
  : difficulties[0]?.nativeName || DEFAULT_SETTINGS.difficulty,

slide: getAvailableSlideOptions().some(option => option.value === Number(raw.slide))
  ? Number(raw.slide)
  : DEFAULT_SETTINGS.slide
};
}

function loadSettings() {
try {
