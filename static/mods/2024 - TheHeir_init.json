  input.placeholder = "Introduce your name";
  input.classList.remove("assistant-name-error");
}

  function installNameEntry(assistantWindow, summary) {
    if (summary.querySelector(".assistant-name-entry")) return;

    const nameEntry = document.createElement("div");
    nameEntry.className = "assistant-name-entry";

    const input = document.createElement("input");
    input.className = "assistant-name-input";
    input.type = "text";
    input.placeholder = "Introduce your name";
    input.maxLength = maxNameLength;

