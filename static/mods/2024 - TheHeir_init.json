function normalizeAssistantName(value) {
  return String(value || "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[’']/g, "")
    .replace(/[^a-z0-9]+/g, " ")
    .trim()
    .replace(/\s+/g, " ");
}

function buildNormalizedList(raw) {
  return raw
    .split(/\r?\n/)
    .map(normalizeAssistantName)
    .filter(Boolean);
}

const blockedLanguageTerms = buildNormalizedList(blockedLanguageRaw);
const timeParadoxNames = new Set(buildNormalizedList(timeParadoxRaw));

function containsBlockedTerm(name, term) {
  return ` ${name} `.includes(` ${term} `);
}

function validateAssistantName(name) {
  const normalizedName = normalizeAssistantName(name);

  if (!normalizedName) {
    return { ok: false };
  }

  if (timeParadoxNames.has(normalizedName)) {
    return {
      ok: false,
      message: "Time Paradox"
    };
  }

  const hasBlockedLanguage = blockedLanguageTerms.some((term) => {
    return normalizedName === term || containsBlockedTerm(normalizedName, term);
  });

  if (hasBlockedLanguage) {
    return {
      ok: false,
      message: "Language!"
    };
  }

  return { ok: true };
}

