;(() => {
    const key = "__heirKeepAdvisorFeedback";
    window[key]?.stop();

    const host = document.getElementById("game_window");
    if (!host) return;

    const selector = "button, input[type='button'], input[type='submit']";
    const disableLabels = new Set([
        "disable advisor feedback",
        "don't give me advice",
        "dont give me advice"
    ]);
    let restored = false;
    const labelOf = control => (control.textContent || control.value || "")
        .trim().toLowerCase().replace(/’/g, "'").replace(/\s+/g, " ");

    function blockDisable(event) {
        const control = event.target.closest?.(selector);
        if (!control || !disableLabels.has(labelOf(control))) return;
        event.preventDefault();
        event.stopImmediatePropagation();
    }

    function syncFeedbackControls() {
        for (const control of host.querySelectorAll(selector)) {
            const label = labelOf(control);
            if (label === "enable advisor feedback" && !restored) {
                restored = true;
                control.click();
            }
            if (disableLabels.has(labelOf(control))) control.remove();
        }
    }

    host.addEventListener("click", blockDisable, true);
    const observer = new MutationObserver(syncFeedbackControls);
    observer.observe(host, {
        childList: true, subtree: true, characterData: true,
        attributes: true, attributeFilter: ["value"]
    });
    window[key] = {
        stop() {
            observer.disconnect();
            host.removeEventListener("click", blockDisable, true);
        }
    };
    syncFeedbackControls();
})();

