if (window.__theHeirSettingsScreenInstalled) return;

const STORAGE_KEY = "theHeir.settings.v2";
const DEFAULT_SETTINGS = {
  difficulty: "Normal",
  slide: 0
};

const BASE_DIFFICULTIES = [
{nativeName:"Cakewalk",html:"<b>BRUZOS</b>",special:"bruzos"},
{nativeName:"Very Easy",html:"So easy, it’s so easy"},
{nativeName:"Easy",html:"Easy"},
{nativeName:"Normal",html:"Normal"},
{nativeName:"Hard",html:"Hard"},
