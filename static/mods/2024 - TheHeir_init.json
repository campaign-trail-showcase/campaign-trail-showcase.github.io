function removeNativePromptText(root, promptPattern) {
  if (!root) return;

  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);

  while (walker.nextNode()) {
    const node = walker.currentNode;

    if (promptPattern.test(node.nodeValue)) {
      node.nodeValue = node.nodeValue.replace(promptPattern, "");
    }
  }
}

  function hideNativeCandidateSelector(candidateWindow, select) {
    select.classList.add("candidate-native-selector-hidden");

    if (select.id) {
      const label = candidateWindow.querySelector(`label[for="${select.id}"]`);
      if (label) label.classList.add("candidate-native-selector-hidden");
    }

    const selectorBlock = select.closest(
      "#candidate_id_button, #candidate_selection, #candidate_selector, .candidate_selection, .candidate-selector"
    );

    if (selectorBlock) {
      selectorBlock.classList.add("candidate-native-selector-hidden");
    }

    Array.from(candidateWindow.childNodes).forEach((node) => {
      if (
        node.nodeType === Node.TEXT_NODE &&
        /please select your candidate/i.test(node.nodeValue)
      ) {
        node.nodeValue = "";
      }
    });
removeNativePromptText(candidateWindow, /Please select your candidate:/i);
  }

  function moveCandidate(step) {
    const candidateWindow = getCandidateWindow();
    const select = getCandidateSelect(candidateWindow);
    if (!select || !select.options.length) return;

    const options = Array.from(select.options).filter(
      (option) => !option.disabled && option.value !== ""
    );

    if (!options.length) return;

    const currentOption = select.options[select.selectedIndex];
    let currentIndex = options.indexOf(currentOption);

    if (currentIndex === -1) currentIndex = 0;

    const nextIndex = (currentIndex + step + options.length) % options.length;
    select.value = options[nextIndex].value;

    select.dispatchEvent(new Event("input", { bubbles: true }));
    select.dispatchEvent(new Event("change", { bubbles: true }));

    updateCandidateGlow(select, candidateWindow);
    installCandidateActionButtons();
  }

function installCandidateActionButtons() {
  const gameWindow = document.querySelector("#game_window");
  if (!gameWindow) return;

  let actionBar = gameWindow.querySelector(".candidate-carousel-actions");

  if (!actionBar) {
    actionBar = document.createElement("div");
    actionBar.className = "candidate-carousel-actions";
    gameWindow.appendChild(actionBar);
  }

  function buttonText(button) {
    return (button.value || button.textContent || "").trim().toLowerCase();
  }

  const allButtons = Array.from(
    document.querySelectorAll('button, input[type="button"], input[type="submit"]')
  ).filter((button) => !button.classList.contains("candidate-carousel-arrow"));

  const existingBack = Array.from(actionBar.children).find(
    (button) => buttonText(button) === "back"
  );

  const existingContinue = Array.from(actionBar.children).find(
    (button) => buttonText(button) === "continue"
  );

  const backButton =
    existingBack ||
    allButtons.find((button) => buttonText(button) === "back" && !button.closest(".candidate-carousel-actions"));

  const continueButton =
    existingContinue ||
    allButtons.find((button) => buttonText(button) === "continue" && !button.closest(".candidate-carousel-actions"));

  if (backButton && backButton.parentElement !== actionBar) {
    actionBar.appendChild(backButton);
  }

  if (continueButton && continueButton.parentElement !== actionBar) {
    actionBar.appendChild(continueButton);
  }

  [backButton, continueButton].forEach((button) => {
    if (!button) return;

    button.hidden = false;
    button.style.display = "inline-block";
    button.style.visibility = "visible";
    button.style.opacity = "1";
  });

  allButtons.forEach((button) => {
    const text = buttonText(button);
    const isExtraBack = text === "back" && button !== backButton;
    const isExtraContinue = text === "continue" && button !== continueButton;

    if (isExtraBack || isExtraContinue) {
      button.hidden = true;
      button.style.display = "none";
    }
  });

  const candidateWindow = getCandidateWindow();
  const select = getCandidateSelect(candidateWindow);

  if (
    continueButton &&
    isCarouselWindowVisible(candidateWindow)
  ) {
    const isTrump =
      Number(select?.value) ===
      DONALD_TRUMP_CANDIDATE_PK;

    continueButton.disabled = !isTrump;

    continueButton.setAttribute(
      "aria-disabled",
      String(!isTrump)
    );

    continueButton.classList.toggle(
      "assistant-continue-locked",
      !isTrump
    );

    continueButton.classList.toggle(
      "assistant-continue-unlocked",
      isTrump
    );
  }
}

function isCarouselWindowVisible(element) {
  if (!element) return false;

  const style = window.getComputedStyle(element);
  const rect = element.getBoundingClientRect();

  return (
    style.display !== "none" &&
    style.visibility !== "hidden" &&
    rect.width > 0 &&
    rect.height > 0
  );
}

function syncCarouselHostState() {
  const gameWindow = document.querySelector("#game_window");
  const candidateWindow = document.querySelector("#inner_window_3");
