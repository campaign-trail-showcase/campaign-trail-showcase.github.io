{nativeName:"Blowout",html:"<b>TABUENCA</b>",special:"tabuenca"}
];

const BRUZOS_NAMES = new Set([
"david bruzos","bruzos","bruzeros","bruzeria"
]);

const TABUENCA_NAMES = new Set([
"guillem","malvehy","tabuenca","osama bin laden","guillem malvehy"
]);

const SLIDE_OPTIONS = [
  {label:"Presidential Cabinet",value:0},
  {label:"List of Presidents",value:1},
  {label:"Cabinet & List",value:2}
];

function normalizeName(value) {
return String(value || "")
.normalize("NFD")
.replace(/[\u0300-\u036f]/g,"")
.toLowerCase()
.replace(/[’']/g,"")
.replace(/[^a-z0-9]+/g," ")
.trim()
.replace(/\s+/g," ");
}

function getAssistantName() {
return String(
window.__assistantChosenName ||
sessionStorage.getItem("assistantChosenName") ||
""
);
}

function getAvailableDifficulties() {
const name = normalizeName(getAssistantName());
const bruzos = BASE_DIFFICULTIES.find(x => x.special === "bruzos");
const tabuenca = BASE_DIFFICULTIES.find(x => x.special === "tabuenca");

if (BRUZOS_NAMES.has(name)) return [bruzos];
if (TABUENCA_NAMES.has(name)) return [tabuenca];

return BASE_DIFFICULTIES.filter(x => !x.special);
}

const presidentialListAchievements = [
  "Glaube und Hoffnung", "Weltkrieg", "Tausendjährig", "Kulturkampf",
  "Freiheit und Brot", "Luftwaffe", "Harzburger Front",
  "Keine Nazi-Polka", "Nun, Dönitz", "Walküre", "Nuremberg"
];

const gavinChoiceAchievements = [
  "Anti-Komintern", "Kristallnacht", "Barbarossa", "Munich", "Kolibri"
];

window.theHeirAchievementStorage = {
  modName() {
    return window.modBeingPlayed || "The Heir";
  },

  read() {
    try {
      const raw = typeof _rawStorageGetItem === "function"
        ? _rawStorageGetItem.call(localStorage, "unlockedAch")
        : localStorage.getItem("unlockedAch");

      return JSON.parse(raw || "{}") || {};
    } catch {
      return null;
    }
  },

  has(saved, title) {
    if (!saved) return false;

    const modName = this.modName();
    if (saved[`${modName}:${title}`]) return true;

    const legacy = saved[title];
    if (legacy?.modName) return legacy.modName === modName;

    return legacy === true &&
      !Object.keys(saved).some(key => key.endsWith(`:${title}`));
  }
};

window.heirCheatsOn = () =>
  (typeof cheatsActive !== "undefined" && cheatsActive === true) ||
  (typeof cheats !== "undefined" && +cheats === 1) || +window.cheats === 1;

window.heirHasAchievementGate = function (gate) {
  if (gate === "presidential-list" && window.heirCheatsOn()) return true;
  const storage = window.theHeirAchievementStorage;
  const unlocked = storage.read();
  const has = title => storage.has(unlocked, title);
  if (gate === "presidential-list") return presidentialListAchievements.some(has);
  if (gate === "gavin-choice") return gavinChoiceAchievements.every(has);
  if (gate === "candidate-boost" || gate === "all-achievements") {
    const titles = Object.keys(campaignTrail_temp.achievements || {});
    return titles.length > 0 && titles.every(has);
  }
  return false;
};

function getAvailableSlideOptions() {
